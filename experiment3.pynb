     "text": [
      "Enter a string: riyana\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "New string: aiyanr\n"
     ]
    }
   ],
   "source": [
    "#change given string to new string\n",
    "s=input(\"Enter a string:\")\n",
    "new_string=s[-1]+s[1:-1]+s[0]\n",
    "print(\"New string:\",new_string)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "c92b2fea-2b6f-4266-978c-9d45f443ae8b",
   "metadata": {},
   "outputs": [
