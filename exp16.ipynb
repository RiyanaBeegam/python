   "source": [
    "try:\n",
    "    num = int(input(\"Enter a number: \"))\n",
    "\n",
    "    if num < 0:\n",
    "        raise ValueError(\"Negative numbers are not allowed\")\n",
    "\n",
    "    print(\"You entered:\", num)\n",
    "\n",
    "except ValueError as e:\n",
    "    print(\"Invalid input:\", e)\n",
    "\n",
    "finally:\n",
    "    print(\"Program execution completed\")"
   ]
